{
  "name": "experiments-electron",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w apps/desktop -w apps/web",
    "typecheck": "npm run typecheck -w apps/desktop -w apps/web",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:desktop:headless": "xvfb-run -a npm run dev -w apps/desktop",
    "dev:web": "npm run dev -w apps/web",
    "start:web": "npm run build -w apps/web && npm run start -w apps/web",
    "package:desktop": "npm run package -w apps/desktop"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
