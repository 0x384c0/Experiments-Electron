{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: desktop",
      "type": "shell",
      "command": "npm run build -w apps/desktop",
      "problemMatcher": []
    },
    {
      "label": "build: web",
      "type": "shell",
      "command": "npm run build -w apps/web",
      "problemMatcher": []
    },
    {
      "label": "dev: web server",
      "type": "shell",
      "command": "npm run dev -w apps/web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
