{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: desktop",
      "type": "shell",
      "command": "npm run build -w apps/desktop",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build: web",
      "type": "shell",
      "command": "npm run build -w apps/web",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "start: web server",
      "type": "shell",
      "command": "npm run start:web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "web app on"
        }
      }
    }
  ]
}
