# Not read by CI directly. Copy each value into a GitHub repo secret
# with the same name (Settings -> Secrets and variables -> Actions)
# to enable .github/workflows/deploy_azure.yml.

# Service principal credentials JSON, scoped to the resource group below:
#   az ad sp create-for-rbac --name "experiments-electron-deploy" --role contributor \
#     --scopes /subscriptions/<sub-id>/resourceGroups/<rg-name> --sdk-auth
AZURE_CREDENTIALS=

# Azure Container Registry name, without the .azurecr.io suffix
AZURE_CONTAINER_REGISTRY=

# Resource group containing the Container App
AZURE_RESOURCE_GROUP=

# Container App name to update with the new image
AZURE_CONTAINERAPP_NAME=
